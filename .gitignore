__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
ENV/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Environment files
.env
.env.local
.env.production

# Database files
*.db
*.db-journal
*.db-wal
*.db-shm

# Docker
.dockerignore

# Documentation
LICENSE

# Temporary files
*.log
*.tmp
*.temp
.cache/

# Alembic
alembic/versions/*.py
!alembic/versions/.gitkeep

# Render
render.yaml
