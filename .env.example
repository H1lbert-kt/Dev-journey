# ============================================
# DevJourney - Environment Variables
# ============================================

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://devjourney:devjourney_secure_password@db:5432/devjourney

# PostgreSQL Configuration
POSTGRES_DB=devjourney
POSTGRES_USER=devjourney
POSTGRES_PASSWORD=devjourney_secure_password
POSTGRES_PORT=5431

# Application Configuration
SECRET_KEY=change-this-to-a-random-secret-key
APP_PORT=8001

# Sentry (optional — for error monitoring in production)
# Install: pip install "sentry-sdk[fastapi]"
SENTRY_DSN=

# Telegram Notifications & Monitoring (optional — receives error alerts with approval buttons)
# 1. Create a bot via @BotFather on Telegram
# 2. Get the bot token from BotFather
# 3. Get your chat_id by messaging @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Logging
LOG_LEVEL=INFO
ENVIRONMENT=development

# For local development with SQLite (uncomment below)
# DATABASE_URL=sqlite:///./devjourney.db
