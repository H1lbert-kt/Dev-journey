# ============================================
# DevJourney - Environment Variables
# ============================================

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://devjourney:devjourney_secure_password@db:5432/devjourney

# PostgreSQL Configuration
POSTGRES_DB=devjourney
POSTGRES_USER=devjourney
POSTGRES_PASSWORD=devjourney_secure_password
POSTGRES_PORT=5431

# Application Configuration
SECRET_KEY=change-this-to-a-random-secret-key
APP_PORT=8001

# For local development with SQLite (uncomment below)
# DATABASE_URL=sqlite:///./devjourney.db
