# ============================================
# DevJourney - Variáveis de Ambiente
# ============================================
# INSTRUÇÕES:
# 1. Copie este arquivo para .env: cp .env.example .env
# 2. Gere uma SECRET_KEY segura: python -c "import secrets; print(secrets.token_hex(32))"
# 3. Configure as senhas do PostgreSQL
# 4. NUNCA versione o arquivo .env
# ============================================

# Chave secreta para assinatura de sessões (OBRIGATÓRIO em produção)
# Gere uma chave segura com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Configuração do Banco de Dados (PostgreSQL)
DATABASE_URL=postgresql://devjourney:SUA_SENHA_SEGURA@db:5432/devjourney

# Configuração do PostgreSQL
POSTGRES_DB=devjourney
POSTGRES_USER=devjourney
POSTGRES_PASSWORD=SUA_SENHA_SEGURA_AQUI
POSTGRES_PORT=5431

# Configuração da Aplicação
APP_PORT=8001

# Sentry (opcional — para monitoramento de erros em produção)
# Instale: pip install "sentry-sdk[fastapi]"
SENTRY_DSN=

# Notificações Telegram & Monitoramento (opcional)
# 1. Crie um bot via @BotFather no Telegram
# 2. Obtenha o token do bot
# 3. Obtenha seu chat_id via @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Logging
LOG_LEVEL=INFO
ENVIRONMENT=development

# Para desenvolvimento local com SQLite (descomente abaixo)
# DATABASE_URL=sqlite:///./devjourney.db